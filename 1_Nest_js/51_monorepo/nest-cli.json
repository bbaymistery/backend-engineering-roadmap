{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/auth-app/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/auth-app/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/auth-app",
  "projects": {
    "auth-app": {
      "type": "application",
      "root": "apps/auth-app",
      "entryFile": "main",
      "sourceRoot": "apps/auth-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-app/tsconfig.app.json"
      }
    },
    "user-app": {
      "type": "application",
      "root": "apps/user-app",
      "entryFile": "main",
      "sourceRoot": "apps/user-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-app/tsconfig.app.json"
      }
    },
    "external": {
      "type": "library",
      "root": "libs/external",
      "entryFile": "index",
      "sourceRoot": "libs/external/src",
      "compilerOptions": {
        "tsConfigPath": "libs/external/tsconfig.lib.json"
      }
    }
  }
}
